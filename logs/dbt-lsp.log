11:12:43.361325 [debug]: Query executed on node unknown:
select * from (
with 

--Staging CTEs
payments as (

  select * from `dbt-refactoring`.`ktspls_refactoring`.`stg__payments`

),

orders as (
    
    select * from `dbt-refactoring`.`ktspls_refactoring`.`stg__orders`

),

customers as (
    
    select * from `dbt-refactoring`.`ktspls_refactoring`.`stg__customers`

),

completed_payments as (
    select
        order_id,
        max(date_created) as payment_finalized_date,
        sum(amount) / 100.0 as total_amount_paid
        from
        payments
    where
        status <> 'fail'
    group by 
    1
),

paid_orders as (
    select
        orders.order_id,
        orders.customer_id,
        orders.order_placed_at,
        orders.order_status,
        completed_payments.total_amount_paid,
        completed_payments.payment_finalized_date,
        customers.customer_first_name,
        customers.customer_last_name
    from
        orders
        left join completed_payments on orders.order_id = completed_payments.order_id
        left join customers on orders.customer_id = customers.customer_id
),

customer_orders as (
    select
        customer.id as customer_id,
        min(orders.order_placed_at) as first_order_date,
        max(orders.order_placed_at) as most_recent_order_date,
        count(orders.order_id) as number_of_orders
    from
        customers
        left join orders on orders.customer_id = customers.customer_id
    group by
        1
)
SELECT * FROM customer_orders
) limit 1000
