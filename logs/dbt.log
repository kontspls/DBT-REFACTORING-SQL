11:07:00.890911 [debug]: Query executed on node model.dbt-refactoring.fct_customer_orders:
/* {"app": "dbt", "dbt_version": "2.0.0", "invocation_id": "01a18757-6507-7930-b606-336e32924620", "node_id": "model.dbt-refactoring.fct_customer_orders", "profile_name": "dbt-refactoring", "target_name": "dev"} */
create or replace view `dbt-refactoring`.`ktspls_refactoring`.`fct_customer_orders`
  
  as (
    with 

--Staging CTEs
payments as (

  select * from `dbt-refactoring`.`ktspls_refactoring`.`stg__payments`

),

orders as (
    
    select * from `dbt-refactoring`.`ktspls_refactoring`.`stg__orders`

),

customers as (
    
    select * from `dbt-refactoring`.`ktspls_refactoring`.`stg__customers`

),

paid_orders as (
    select
        orders.order_id,
        orders.customer_id,
        orders.order_placed_at,
        orders.order_status,
        payments.total_amount_paid,
        payments.payment_finalized_date,
        customers.customer_first_name,
        customers.customer_last_name
    from
        orders
        left join payments on orders.order_id = payments.order_id
        left join customers on orders.customer_id = customers.customer_id
),

customer_orders as (
    select
        customers.id as customer_id,
        min(orders.order_placed_at) as first_order_date,
        max(orders.order_placed_at) as most_recent_order_date,
        count(orders.order_id) as number_of_orders
    from
        customers
        left join orders on orders.customer_id = customers.id
    group by
        1
),

completed_payments as (
    select
        order_id,
        max(date_created) as payment_finalized_date,
        sum(amount) / 100.0 as total_amount_paid
        from
        payments
    where
        status <> 'fail'
    group by 
    1
),

--final CTE
final as (
    select
        paid_orders.*,
        row_number() over (
            order by
                paid_orders.order_id
        ) as transaction_seq,
        row_number() over (
            partition by
                customer_id
            order by
                paid_orders.order_id
        ) as customer_sales_seq,
        case
            when (
                rank() over (
                    partition by
                        customer_id
                    order by
                        order_placed_at,
                        order_id
                ) = 1
            ) then 'new'
            else 'return'
        end as nvsr,
        sum(paid_orders.total_amount_paid) over (
            partition by
                paid_orders.customer_id
            order by
                paid_orders.order_id rows between unbounded preceding
                and current row
        ) as customer_lifetime_value,
        min(paid_orders.order_placed_at) over (
            partition by
                paid_orders.customer_id
        ) as fdos
    from
        paid_orders
    order by
        order_id
)
-- Simple Select Statement
select
    *
from
    final
  )
