create or replace temporary view `test_supply_costs_sum_correctly__dbt_tmp` as
      select * from (
        with

order_items as (

    select * from `dbt-refactoring`.`dbt_ktspls`.`stg_order_items`

),


orders as (

    select * from `dbt-refactoring`.`dbt_ktspls`.`stg_orders`

),

